import { Button } from "std-widgets.slint";
import { Theme } from "./theme.slint";

/// Zoom slider with +/- buttons, a draggable track, and a percentage label.
///
/// `zoom-level` is bound bidirectionally by the parent view; range is 100–400.
export component ZoomSlider inherits Rectangle {
    in-out property <float> zoom-level: 100.0;
    property <float> min-value: 100.0;
    property <float> max-value: 400.0;
    property <float> step-size: 25.0;
    property <float> range: max(1.0, max-value - min-value);
    property <float> normalized: range == 0 ? 0.0 : max(0.0, min(1.0, (zoom-level - min-value) / range));

    height: 40px;
    horizontal-stretch: 1;
    border-width: 1px;
    border-radius: 4px;
    border-color: Theme.colors.border_default;
    background: Theme.colors.bg_card;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        // "Zoom:" label
        Text {
            text: "Zoom:";
            font-size: 10pt;
            color: Theme.colors.text_secondary;
            vertical-alignment: center;
        }

        Button {
            text: "-";
            width: 32px;
            clicked => {
                zoom-level = max(min-value, zoom-level - step-size);
            }
        }

        // Percentage label
        Rectangle {
            width: 50px;
            height: 100%;

            Text {
                text: round(zoom-level) + "%";
                font-size: 10pt;
                color: Theme.colors.text_secondary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Draggable slider track
        track-area := Rectangle {
            width: 150px;
            height: 100%;

            // Track background
            Rectangle {
                width: 100%;
                y: (parent.height - 4px) / 2;
                height: 4px;
                border-radius: 2px;
                background: Theme.colors.bg_secondary;

                // Filled portion
                Rectangle {
                    width: normalized * parent.width;
                    height: 100%;
                    background: Theme.colors.accent_primary;
                    border-radius: 2px;
                }
            }

            // Thumb
            Rectangle {
                width: 12px;
                height: 12px;
                x: normalized * (parent.width - self.width);
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: Theme.colors.accent_primary;
                border-width: 2px;
                border-color: white;
            }

            // Touch area that handles drag to set zoom level directly.
            TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                pointer-event(ev) => {
                    if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                        zoom-level = clamp(min-value + (self.mouse-x / track-area.width) * range,
                            min-value, max-value);
                    }
                }
                moved => {
                    if self.pressed {
                        zoom-level = clamp(min-value + (self.mouse-x / track-area.width) * range,
                            min-value, max-value);
                    }
                }
            }
        }

        Button {
            text: "+";
            width: 32px;
            clicked => {
                zoom-level = min(max-value, zoom-level + step-size);
            }
        }

        // Reset to 100%
        Button {
            text: "1:1";
            width: 36px;
            clicked => {
                zoom-level = 100.0;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }
}
